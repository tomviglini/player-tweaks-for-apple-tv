{
  "manifest_version": 3,
  "name": "Player Tweaks for Apple TV",
  "version": "0.2.1",
  "description": "Cleans the Apple TV Web player overlay, controls stream quality and auto subtitles, and shows playback debug info.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tv.apple.com/*"
      ],
      "js": [
        "ui-controls.js",
        "player-tools.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://tv.apple.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tv.apple.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Player Tweaks for Apple TV",
    "default_popup": "popup.html"
  }
}
